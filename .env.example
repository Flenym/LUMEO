# Lumeo — environment template.
# Copy to .env for local dev:  cp .env.example .env
# NEVER commit a real .env with secrets to the repo.
# All values below are EMPTY placeholders on purpose (secrets-guard CI allows this file).

PORT=5267
DATABASE_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
CLOUDPUB_DOMAIN=
STORAGE_PATH=./storage
CURRENCY_NAME=EMBER
